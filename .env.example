APP_NAME="Salon de la Danse"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Compte administrateur de developpement, cree par AdminSeeder.
# Renseigner ces valeurs dans .env uniquement : jamais ici, jamais dans le code.
SALON_ADMIN_FIRST_NAME=
SALON_ADMIN_LAST_NAME=
SALON_ADMIN_EMAIL=
SALON_ADMIN_PHONE=
SALON_ADMIN_PASSWORD=

# Jauge par defaut appliquee a chaque creneau par ShiftSeeder.
SALON_DEFAULT_SHIFT_CAPACITY=4
# Part de places libres en dessous de laquelle un creneau passe en ambre.
SALON_GAUGE_TIGHT_RATIO=0.25

# Nombre de codes d invitation de test generes par InvitationCodeSeeder.
SALON_SEED_INVITATION_CODES=20

# Nombre de benevoles fictifs crees par VolunteerSeeder (developpement seulement).
SALON_SEED_VOLUNTEERS=150

# Poids maximal de la photo du benevole, en kilo-octets.
SALON_PHOTO_MAX_KILOBYTES=4096

# Coordonnees de l equipe organisatrice, affichees sur le dashboard benevole.
SALON_CONTACT_NAME=
SALON_CONTACT_EMAIL=
SALON_CONTACT_PHONE=

# Hebergeur affiche dans les mentions legales (l editeur a ses valeurs par
# defaut dans config/salon.php).
SALON_LEGAL_HOST_NAME=
SALON_LEGAL_HOST_ADDRESS=
SALON_LEGAL_HOST_WEBSITE=
